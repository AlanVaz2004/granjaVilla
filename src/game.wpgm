import wollok.game.*
import hector.*
import cultivos.*

program farmville {
	//  CONFIG	
	game.title("La granja de Héctor")
	game.height(10)
	game.width(10)
	game.ground("ground.png")

	//  VISUALES
 	game.addVisualCharacter(hector)
 	game.addVisual(new Maiz()) // Se agrega a modo de prueba

	//Teclas
	keyboard.m().onPressDo({ hector.planta(new Maiz()) })
 	
 	//  COMIENZA
	game.start()
}
